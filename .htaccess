# Jubis Games — configuração Apache
DirectoryIndex index.php index.html

# Ativar compressão para arquivos estáticos
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache longo para assets versionados (imagens, CSS, JS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml       "access plus 30 days"
  ExpiresByType image/png           "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 30 days"
  ExpiresByType image/webp          "access plus 30 days"
</IfModule>

# HTML e PHP NÃO ficam em cache: assim toda atualização aparece na hora
# (os .js/.css mudam de versão via ?v=N, então podem ter cache longo)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Não permitir listagem de diretórios
Options -Indexes

# Bloquear acesso direto à pasta de includes
<DirectoryMatch "/includes/">
  Require all denied
</DirectoryMatch>

# Erro 404 personalizado: volta pro index
ErrorDocument 404 /index.php
